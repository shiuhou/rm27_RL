!configs/contact_rl/ppo_minimal.json
!rm27/
rm27/*
!rm27/__init__.py
!rm27/integration/
rm27/integration/*
!rm27/integration/__init__.py
!rm27/integration/drone.py
!rm27/experiments/
rm27/experiments/*
!rm27/experiments/__init__.py
!rm27/experiments/calibration.py
!rm27/experiments/contact_metrics.py
!rm27/experiments/aggressive_contact/
rm27/experiments/aggressive_contact/*
